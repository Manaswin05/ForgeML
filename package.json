{
  "name": "forgeml",
  "version": "1.2.0",
  "description": "ML Training Platform — React + FastAPI",
  "scripts": {
    "dev": "concurrently --names \"API,UI\" --prefix-colors \"magenta,cyan\" \"python run.py dev\" \"npm run dev:ui\"",
    "dev:api": "python run.py dev",
    "dev:ui": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "setup": "python run.py setup && npm install --prefix frontend",
    "test": "python run.py test",
    "test-api": "python test_api.py",
    "status": "python cli.py status",
    "models": "python cli.py models",
    "upload": "python cli.py upload",
    "cli": "python cli.py interactive"
  },
  "bin": {
    "forgeml": "./run.py",
    "forge-cli": "./cli.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "machine-learning",
    "fastapi",
    "ml-platform",
    "automl",
    "no-code",
    "react",
    "typescript"
  ],
  "author": "ForgeML Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/forgeml.git"
  },
  "engines": {
    "python": ">=3.8",
    "node": ">=18"
  }
}
